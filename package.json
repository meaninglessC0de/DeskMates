    "@fastify/static": "10.1.11",
    "@fastify/websocket": "11.3.7",
    "@mlflow/claude-code": "0.5.0",
    "@mlflow/core": "0.5.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@stylexjs/stylex": "0.19.2",
    "@trycua/cua": "0.27.4",
    "dotenv": "18.0.10",
    "fastify": "5.12.8",
    "livekit-client": "2.24.1",
    "livekit-server-sdk": "2.19.3",
    "lucide-react": "1.73.0",
