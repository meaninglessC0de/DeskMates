{
  "name": "deskmates",
  "version": "1.0.0",
  "description": "Deskmates: hire and manage a team of AI employees, each with its own desktop.",
  "scripts": {
    "astryx": "astryx",
    "office": "tsx src/office/main.ts",
    "office:once": "tsx src/office/main.ts",
    "web": "vite --config vite.web.config.ts",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "seed": "tsx scripts/seed.ts",
    "shots": "tsx scripts/shots.ts",
    "typecheck": "tsc --noEmit -p tsconfig.office.json --pretty false && tsc --noEmit -p tsconfig.web.json --pretty false && tsc --noEmit -p tsconfig.node.json --pretty false",
    "typecheck:area": "node scripts/typecheck-area.mjs",
    "purity": "node scripts/purity.mjs",
    "test": "vitest run",
    "check": "npm run typecheck && npm run test && npm run purity -- src/renderer"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/meaninglessC0de/AgentManager.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/meaninglessC0de/AgentManager/issues"
  },
  "homepage": "https://github.com/meaninglessC0de/AgentManager#readme",
  "private": true,
